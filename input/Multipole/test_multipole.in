#======================================================================
# COMPUTATION
#======================================================================

 Method {

     # "multipole": compute gravitational acceleration using FMM

     list = [ "multipole" ];

     multipole {
         
	 theta = 0.00001;
	 eps0 = 0.0;
	 r0 = 0.0;
	 interp_xpoints = 256;
	 interp_ypoints = 256;
	 interp_zpoints = 256;
     }
 }

#======================================================================
# OUTPUT
#======================================================================

 Output {
    # list = ["de", "data"];
    list = ["de", "accel"];

    de {
         field_list = [ "density" ];
         image_size = [ 256, 256 ];
         image_specify_bounds = true;
         image_type = "data";
         name = [ "multipole-dens-%03d.png", "cycle" ];
	 image_lower = [0.0, 0.0, 0.5];
	 image_upper = [1.0, 1.0, 0.5];
         schedule {
             step = 100;
             var = "cycle";
         };
         type = "image";
     };

     accel {
         field_list = [ "acceleration_x" ];
         image_size = [ 256, 256 ];
         image_specify_bounds = true;
         image_type = "data";
         name = [ "multipole-accel-%03d.png", "cycle" ];
	 image_lower = [0.0, 0.0, 0.5];
	 image_upper = [1.0, 1.0, 0.5];
         schedule {
             step = 100;
             var = "cycle";
         };
         type = "image";
     };

     #data {
     #    type = "data";
     #	 field_list = ["density", "acceleration_x", "acceleration_y", "acceleration_z"];
     #    name = ["data-%03d.h5", "proc"];
     #    dir = ["multipole_test_%.4f","time"];
     #    schedule {
     #        # var = "time";
     #        # list = [0.0, 1.1547005383792517];

     #	     var = "cycle";
     #	     list = [0, 1];
     #    }
     # };
 }
